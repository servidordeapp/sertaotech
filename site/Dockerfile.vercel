# syntax=docker/dockerfile:1
#
# Imagem que a Vercel builda e roda para o serviço `site` (ver services.site no
# vercel.json da raiz). É separada do Dockerfile por decisão da plataforma: o
# runtime de container da Vercel lê o arquivo apontado em `entrypoint` e não
# aceita escolher estágio de outro Dockerfile. O conteúdo espelha os estágios
# build e prod do Dockerfile — ao mexer em um, mexa no outro.
#
# Diferença única em relação ao Dockerfile: aqui não existe estágio de
# desenvolvimento, e a Vercel injeta $PORT em runtime.

FROM node:24-bookworm-slim AS build
WORKDIR /app
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
# O nginx precisa escutar na porta que a Vercel injeta. O FILTER limita o
# envsubst a $PORT — sem ele o $uri das regras do template vira string vazia.
ENV NGINX_ENVSUBST_FILTER=PORT
ENV PORT=3000
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
