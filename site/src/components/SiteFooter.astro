---
/**
 * Rodapé. A casca (marca, barra de baixo, redes) é igual em todas as páginas;
 * as colunas do meio mudam por edição, então entram pelo slot — 2026 lista as
 * páginas do arquivo, 2027 lista as 3 listas de espera.
 */
import { SITE } from '../lib/site';

export interface Props {
  /** Linha de uma frase embaixo da marca. */
  about: string;
  /** Apoio como nome escrito (2026) ou como logomarca (2027). */
  apoio?: 'nomes' | 'logos';
}
const { about, apoio = 'nomes' } = Astro.props;
---
<!-- FOOTER -->
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__about">
        <span class="brand">
          <img src="/assets/logo-96.webp" alt="" width="96" height="96" loading="lazy" decoding="async" style="width: 44px; height: auto; max-width: 100%; object-fit: contain;">
          <span class="site-footer__word">Sertão Tech</span>
        </span>
        <p>{about}</p>
      </div>
      <div class="site-footer__cols">
        <slot />
        <div>
          <h3><span aria-hidden="true">// </span>contato</h3>
          <a href={SITE.instagram} target="_blank" rel="noopener">Instagram @osertaotech</a>
          <a href={SITE.whatsapp} target="_blank" rel="noopener">WhatsApp {SITE.whatsappLabel}</a>
        </div>
        <div>
          <h3><span aria-hidden="true">// </span>apoio</h3>
          {apoio === 'logos' ? (
            <div class="static site-footer__apoio">
              <img src="/assets/patrocinadores/phppi-branco.svg" alt="PHP PI" width="240" height="186" loading="lazy" decoding="async">
              <img src="/assets/patrocinadores/phpwomen-piaui.svg" alt="PHPWomen PI" width="240" height="309" loading="lazy" decoding="async">
            </div>
          ) : (
            <>
              <div class="static">PHP PI</div>
              <div class="static">PHPWomen PI</div>
            </>
          )}
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>#sertaotech · © 2026</span>
      <div class="social">
        <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram do Sertão Tech"><svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg></a>
        <a href={SITE.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp da organização"><svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg></a>
      </div>
    </div>
  </div>
</footer>
