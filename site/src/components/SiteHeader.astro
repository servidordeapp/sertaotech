---
/**
 * Cabeçalho fixo. `active` casa com a `key` do link pra marcar
 * aria-current="page".
 *
 * O menu e o CTA vêm por prop porque o site tem duas edições no ar ao mesmo
 * tempo: a vigente na home e o arquivo congelado em /2026 (ver src/data/nav.ts).
 * A página de caravanas manda o CTA direto pro Sympla com UTM próprio e a
 * classe js-cta-inscricao, que o modal de prazo daquela página intercepta.
 */
import { NAV_2027, CTA_2027, type NavLink, type NavCta } from '../data/nav';

export interface Props {
  links?: NavLink[];
  cta?: NavCta;
  /** Destino da logomarca. Na própria home é a âncora do topo. */
  brandHref?: string;
  active?: string;
}
const {
  links = NAV_2027,
  cta = CTA_2027,
  brandHref = '#topo',
  active,
} = Astro.props;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={brandHref}>
      <img src="/assets/logo-96.webp" alt="Sertão Tech" width="96" height="96" decoding="async" style="width: 40px; height: auto; max-width: 100%; object-fit: contain;">
      <span class="brand__word">Sertão Tech</span>
    </a>
    <button class="nav-toggle" type="button" id="navToggle" aria-controls="siteNav" aria-expanded="false" aria-label="Abrir menu"><svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg></button>
    <nav class="site-nav" id="siteNav" aria-label="Navegação principal">
      {links.map((link) => (
        <a class="site-nav__link" href={link.href} aria-current={link.key && active === link.key ? 'page' : undefined}>{link.label}</a>
      ))}
      <span class="site-nav__sep" aria-hidden="true"></span>
      <a
        class:list={['btn', 'btn--primary', 'btn--sm', cta.class]}
        href={cta.href}
        {...(cta.external ? { target: '_blank', rel: 'noopener' } : {})}
      >{cta.label}<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
    </nav>
  </div>
</header>
