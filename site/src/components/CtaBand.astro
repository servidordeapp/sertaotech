---
/** Faixa de conversão no pé da página (css/site.css: .cta). */
export interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}
const { eyebrow, title, lead } = Astro.props;
---
<!-- CTA -->
<div class="cta">
  <div class="cta__glow" aria-hidden="true"></div>
  <section class="section cta__inner">
    <div class="container">
      <span class="eyebrow eyebrow--ink">{eyebrow}</span>
      <h2 class="cta__title">{title}</h2>
      <p class="cta__lead">{lead}</p>
      <div class="hero__actions">
        <slot />
      </div>
    </div>
  </section>
</div>
