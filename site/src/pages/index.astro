---
/**
 * Home da 3ª edição (2027) — porte 1:1 do `index.html` que está em produção.
 * É a página da edição vigente: o que muda de ano em ano mora aqui, e a
 * edição anterior fica congelada em `/2026`.
 *
 * Os 11 `<img>` da galeria e do After viraram dado em `data/fotos-2026.ts`.
 * Os botões das 3 listas de espera levam a `/lista-de-espera/<tipo>`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SponsorTelemetry from '../components/SponsorTelemetry.astro';
import LogoWall from '../components/LogoWall.astro';
import FooterCols2027 from '../components/FooterCols2027.astro';
import { graph, organization, website, webpage } from '../lib/schema';
import { NAV_2027, CTA_2027 } from '../data/nav';
import { GALERIA_2026, AFTER_2026, foto, srcset } from '../data/fotos-2026';
import evento from '../data/evento-2027.json';

const path = '/';
const title = 'Sertão Tech 2027 — Lista de espera';
const description =
  'Sertão Tech 2027: 15 e 16 de outubro, na UFDPar, em Parnaíba. A 2ª edição esgotou. Entre na lista de espera para participar, palestrar ou patrocinar o evento de tecnologia do norte do Piauí.';
const ogImage = '/assets/og-2027-data.jpg';

const jsonLd = graph(
  organization(),
  website(),
  webpage({ path, name: title, description, image: ogImage }),
  evento,
);
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogDescription="15 e 16 de outubro de 2027, na UFDPar. A 2ª edição esgotou. Entre na lista de espera para participar, palestrar ou patrocinar."
  ogImage={ogImage}
  ogImageAlt="Sertão Tech 2027 — 15 e 16 de outubro, UFDPar, Parnaíba - PI"
  jsonLd={jsonLd}
  navLinks={NAV_2027}
  cta={CTA_2027}
  footerAbout="Feito no sertão, pra todo mundo dar o primeiro passo na tecnologia. 3ª edição em 15 e 16 de outubro de 2027, na UFDPar."
  footerApoio="logos"
>

<main>

  <!-- HERO -->
  <div class="hero" id="topo">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__inner">
      <div>
        <span class="eyebrow eyebrow--ink">// 3ª edição · norte do Piauí</span>
        <h1 class="hero__title">Sertão Tech <em>2027</em>.<span class="hero__title-sub"><span style="white-space:nowrap">15 e 16 de outubro ·</span> <span style="white-space:nowrap">UFDPar ·</span> <span style="white-space:nowrap">lista de espera aberta</span></span></h1>
        <p class="hero__lead">A 2ª edição esgotou e lotou o auditório da UFDPar. Em 2027 são dois dias, em parceria com o Bacharelado em Inteligência Artificial. Entre na lista de espera e saiba primeiro quando as inscrições abrirem.</p>
        <div class="hero__actions">
          <a class="btn btn--accent btn--lg" href="/lista-de-espera/participante" data-waitlist="participante">Entrar na lista de espera<svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
        </div>
      </div>
      <div class="hero__art">
        <img class="hero__photo" src="/assets/fotos/2026-foto-oficial-1280.webp" srcset="/assets/fotos/2026-foto-oficial-640.webp 640w, /assets/fotos/2026-foto-oficial-1280.webp 1280w, /assets/fotos/2026-foto-oficial-1920.webp 1920w" sizes="(max-width: 1024px) 100vw, 520px" alt="Foto oficial: participantes e organização reunidos de pé no auditório da UFDPar." width="1920" height="1280" fetchpriority="high" decoding="async">
      </div>
    </div>
    <!-- Números da 2ª edição. -->
    <div class="hero__facts">
      <div class="fact">
        <span class="fact__icon"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
        <div>
          <div class="fact__k">inscritos em 2026</div>
          <div class="fact__v">233</div>
        </div>
      </div>
      <div class="fact">
        <span class="fact__icon"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></svg></span>
        <div>
          <div class="fact__k">palestras e minicursos</div>
          <div class="fact__v">16</div>
        </div>
      </div>
      <div class="fact">
        <span class="fact__icon"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg></span>
        <div>
          <div class="fact__k">caravanas</div>
          <div class="fact__v">4</div>
        </div>
      </div>
      <div class="fact">
        <span class="fact__icon"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg></span>
        <div>
          <div class="fact__k">cidades</div>
          <div class="fact__v">4</div>
        </div>
      </div>
    </div>
  </div>

  <!-- GALERIA DA 2ª EDIÇÃO -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">// como foi a 2ª edição</span>
      <h2 class="section-title">Um dia inteiro de tecnologia na UFDPar</h2>
      <p class="section-lead">Gente de Parnaíba, Luís Correia, Buriti dos Lopes e Teresina reunida pra aprender, trocar e dar o primeiro passo na tecnologia.</p>
      <div class="gallery">
        {GALERIA_2026.map((f) => (
          <img class={f.classe ?? 'photo'} src={foto(f, f.src)} srcset={srcset(f)} sizes={f.sizes} alt={f.alt} width="1920" height="1280" loading="lazy" decoding="async">
        ))}
      </div>
      <p class="section-lead"><a href="/2026">Ver como foi a edição 2026</a></p>
    </div>
  </section>

  <!-- NA MÍDIA: matérias e menções. Nova matéria = novo card, mais recente primeiro. -->
  <section class="section" id="na-midia">
    <div class="container">
      <span class="eyebrow">// na mídia</span>
      <h2 class="section-title">Na mídia</h2>
      <p class="section-lead">Onde o Sertão Tech já foi notícia.</p>
      <div class="grid-3" style="margin-top: 24px;">
        <a class="card card--badge card--interactive" style="display: block; text-decoration: none;" href="https://ufdpar.edu.br/ufdpar/sertao-tech-2026-chega-a-ufdpar-para-apresentar-aos-estudantes-as-carreiras-possiveis-na-tecnologia" target="_blank" rel="noopener">
          <img src="/assets/midia/ufdpar.webp" alt="UFDPar" width="640" height="225" loading="lazy" decoding="async" style="display: block; height: 56px; width: auto; margin-bottom: 14px;">
          <span class="eyebrow">UFDPar · 06 out 2026</span>
          <h3 class="card-title">Sertão Tech 2026 chega à UFDPar para apresentar aos estudantes as carreiras possíveis na tecnologia</h3>
          <p class="card-text">“O principal objetivo do Sertão Tech é aproximar o meio acadêmico do mercado.”</p>
        </a>
      </div>
    </div>
  </section>

  <!-- LISTAS DE ESPERA (o id é o destino dos botões das páginas de 2026) -->
  <div class="band-sunken">
    <section class="section" id="lista-de-espera">
      <div class="container">
        <div class="sponsors-intro">
          <span class="eyebrow">// lista de espera 2027</span>
          <h2 class="section-title" style="margin-bottom: 8px;">Como você quer estar em 2027?</h2>
          <p class="section-lead">São três listas. Leva um minuto, e a gente avisa você primeiro.</p>
        </div>
        <div class="grid-3">
          <div class="card waitlist-card">
            <span class="chip-icon chip-icon--terra"><svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
            <h3 class="card-title">Participar</h3>
            <p class="card-text">Seja avisado quando as inscrições de 2027 abrirem. Em 2026 elas esgotaram antes do evento.</p>
            <a class="btn btn--primary btn--md" href="/lista-de-espera/participante" data-waitlist="participante">Quero participar</a>
          </div>
          <div class="card waitlist-card">
            <span class="chip-icon chip-icon--terra"><svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></svg></span>
            <h3 class="card-title">Palestrar</h3>
            <p class="card-text">Conte o tema que você quer apresentar e avisamos quando a chamada de palestras abrir. Pode ser a sua primeira palestra.</p>
            <a class="btn btn--primary btn--md" href="/lista-de-espera/palestrante" data-waitlist="palestrante">Quero palestrar</a>
          </div>
          <div class="card waitlist-card">
            <span class="chip-icon chip-icon--terra"><svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg></span>
            <h3 class="card-title">Patrocinar</h3>
            <p class="card-text">Receba as cotas de 2027 assim que saírem e conecte sua marca aos talentos de tecnologia do norte do Piauí.</p>
            <a class="btn btn--primary btn--md" href="/lista-de-espera/patrocinador" data-waitlist="patrocinador">Quero patrocinar</a>
          </div>
        </div>

        <!-- Sertão Tech After: benefício de quem palestra e patrocina. Não é
             aberto aos inscritos, então fica fora da galeria do participante. -->
        <div class="after">
          <div class="cta__glow" aria-hidden="true"></div>
          <span class="eyebrow eyebrow--ink">// só pra quem palestra ou patrocina</span>
          <h3 class="section-title section-title--on-ink">Sertão Tech After</h3>
          <p class="cta__lead">Um encontro privado com palestrantes, patrocinadores e organização. Conversa sem pressa, petiscos e drinks.</p>
          <div class="photo-row">
            {AFTER_2026.map((f) => (
              <img class={f.classe ?? 'photo'} src={foto(f, f.src)} srcset={srcset(f)} sizes={f.sizes} alt={f.alt} width="1920" height="1280" loading="lazy" decoding="async">
            ))}
          </div>
          <div class="hero__actions">
            <a class="btn btn--accent btn--lg" href="/lista-de-espera/palestrante" data-waitlist="palestrante">Quero palestrar</a>
            <a class="btn btn--outline-ink btn--lg" href="/lista-de-espera/patrocinador" data-waitlist="patrocinador">Quero patrocinar</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- =========================================================
       QUEM APOIOU EM 2026 (mural de logos)
       Cópia do #patrocinadores de /2026, com utm_content=home2027-<cota>.
       Patrocinador de 2026 não muda mais: se um logo for trocado lá,
       troque aqui também.
       ========================================================= -->
  <section class="section" id="patrocinadores">
      <div class="container">
        <div class="sponsors-intro">
          <span class="eyebrow">// quem apoiou em 2026</span>
          <h2 class="section-title" style="margin-bottom: 8px;">Quem apoiou em 2026</h2>
          <p class="section-lead">Empresas e comunidades que fizeram a 2ª edição acontecer e ajudaram a levar tecnologia pro norte do Piauí.</p>
        </div>

        <LogoWall utm="home2027" apoio="logos" />
      <div class="sponsor-cta">
        <a class="btn btn--primary btn--lg" href="/lista-de-espera/patrocinador" data-waitlist="patrocinador">Quero patrocinar em 2027<svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <div class="cta">
    <div class="cta__glow" aria-hidden="true"></div>
    <section class="section cta__inner">
      <div class="container">
        <span class="eyebrow eyebrow--ink">// 3ª edição</span>
        <h2 class="cta__title">O sertão volta<br>em outubro de 2027.</h2>
        <p class="cta__lead">15 e 16 de outubro, na UFDPar. As vagas de 2026 acabaram antes do evento: entre na lista de espera e garanta o aviso antes da divulgação.</p>
        <div class="hero__actions">
          <a class="btn btn--accent btn--lg" href="/lista-de-espera/participante" data-waitlist="participante">Entrar na lista de espera</a>
          <a class="btn btn--outline-ink btn--lg" href="/2026">Ver como foi a edição 2026</a>
        </div>
      </div>
    </section>
  </div>

</main>
<Fragment slot="footer-cols">
  <FooterCols2027 />
</Fragment>

<SponsorTelemetry slot="scripts" />

<script is:inline slot="scripts">
  // Lista de espera: um waitlist_click por clique num link de formulário, com
  // `tipo` vindo do data-waitlist do link (participante, palestrante ou
  // patrocinador). Link novo para um form só precisa do atributo.
  document.addEventListener('click', function (e) {
    var link = e.target.closest('[data-waitlist]');
    if (!link || typeof gtag !== 'function') return;
    gtag('event', 'waitlist_click', { tipo: link.getAttribute('data-waitlist') });
  });
</script>

</BaseLayout>
