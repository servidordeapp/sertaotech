---
/**
 * Galeria de uma edição. Cada foto abre num lightbox (`<dialog>` nativo, que
 * já traz Esc, trava de foco e backdrop de graça) e tem um ícone de download
 * que entrega o maior arquivo que existe em disco.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FooterCols2027 from '../../components/FooterCols2027.astro';
import { graph, organization, website, webpage } from '../../lib/schema';
import { NAV_2027, CTA_2027 } from '../../data/nav';
import { EDICOES, foto, srcset, maiorLargura, nomeDownload, type Edicao } from '../../data/fotos';

export function getStaticPaths() {
  return Object.values(EDICOES).map((edicao) => ({ params: { ano: edicao.ano }, props: { edicao } }));
}

const { edicao } = Astro.props as { edicao: Edicao };

const path = `/fotos/${edicao.ano}`;
const title = `Fotos da ${edicao.titulo} — Sertão Tech`;
const description = `${edicao.fotos.length} fotos do Sertão Tech ${edicao.ano}, em Parnaíba. Clique para ampliar ou baixe em alta resolução.`;
const ogImage = foto(edicao.fotos[0], edicao.fotos[0].src);

const jsonLd = graph(organization(), website(), webpage({ path, name: title, description, image: ogImage }));
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogImage={ogImage}
  ogImageAlt={edicao.fotos[0].alt}
  jsonLd={jsonLd}
  nav="fotos"
  navLinks={NAV_2027}
  cta={CTA_2027}
  footerAbout="Feito no sertão, pra todo mundo dar o primeiro passo na tecnologia. 3ª edição em 15 e 16 de outubro de 2027, na UFDPar."
  footerApoio="logos"
>
<main id="conteudo">
  <section class="section">
    <div class="container">
      <span class="eyebrow">// galeria · <a href="/fotos">todas as edições</a></span>
      <h1 class="section-title">{edicao.titulo}</h1>
      <p class="section-lead">{edicao.descricao} Clique na foto para ampliar, ou use o ícone para baixar em alta.</p>

      <div class="gal-grid">
        {edicao.fotos.map((f, i) => (
          <figure class="gal-item">
            <button
              class="gal-open"
              type="button"
              data-i={i}
              data-full={foto(f, maiorLargura(f))}
              data-alt={f.alt}
              data-nome={nomeDownload(f)}
              aria-label={`Ampliar: ${f.alt}`}
            >
              <img
                class="photo"
                src={foto(f, f.src)}
                srcset={srcset(f)}
                sizes="(max-width: 600px) 50vw, (max-width: 980px) 33vw, 300px"
                alt={f.alt}
                width="1920"
                height="1280"
                loading="lazy"
                decoding="async"
              >
            </button>
            <a
              class="gal-dl"
              href={foto(f, maiorLargura(f))}
              download={nomeDownload(f)}
              aria-label={`Baixar foto em alta: ${f.alt}`}
            >
              <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            </a>
          </figure>
        ))}
      </div>
    </div>
  </section>
</main>

<Fragment slot="footer-cols">
  <FooterCols2027 />
</Fragment>

<Fragment slot="after-footer">
<dialog class="lightbox" id="lightbox" aria-label="Foto ampliada">
  <button class="lightbox__btn lightbox__close" type="button" id="lbClose" aria-label="Fechar">
    <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>
  <button class="lightbox__btn lightbox__nav lightbox__nav--prev" type="button" id="lbPrev" aria-label="Foto anterior">
    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
  </button>
  <button class="lightbox__btn lightbox__nav lightbox__nav--next" type="button" id="lbNext" aria-label="Próxima foto">
    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
  </button>
  <img class="lightbox__img" id="lbImg" alt="" width="1920" height="1280">
  <div class="lightbox__bar">
    <p class="lightbox__cap" id="lbCap"></p>
    <a class="btn btn--primary btn--md" id="lbDl" href="" download>
      <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
      Baixar
    </a>
  </div>
</dialog>
</Fragment>

<script is:inline slot="scripts">
  // Lightbox da galeria. `<dialog>` nativo resolve Esc, trava de foco e
  // backdrop; aqui só trocamos a foto. Sem JS (ou em navegador sem showModal),
  // os botões não fazem nada e o ícone de baixar continua funcionando — ele é
  // um <a download> comum.
  (function () {
    var dlg = document.getElementById('lightbox');
    if (!dlg || typeof dlg.showModal !== 'function') return;

    var botoes = Array.prototype.slice.call(document.querySelectorAll('.gal-open'));
    if (!botoes.length) return;

    var img = document.getElementById('lbImg');
    var cap = document.getElementById('lbCap');
    var dl = document.getElementById('lbDl');
    var atual = 0;

    // Índice circular: da última foto a seta "próxima" volta pra primeira.
    function mostrar(n) {
      atual = (n + botoes.length) % botoes.length;
      var b = botoes[atual];
      img.src = b.dataset.full;
      img.alt = b.dataset.alt;
      cap.textContent = b.dataset.alt;
      dl.href = b.dataset.full;
      dl.setAttribute('download', b.dataset.nome);
    }

    botoes.forEach(function (b, n) {
      b.addEventListener('click', function () {
        mostrar(n);
        dlg.showModal();
      });
    });

    document.getElementById('lbPrev').addEventListener('click', function () { mostrar(atual - 1); });
    document.getElementById('lbNext').addEventListener('click', function () { mostrar(atual + 1); });
    document.getElementById('lbClose').addEventListener('click', function () { dlg.close(); });

    dlg.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); mostrar(atual - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); mostrar(atual + 1); }
    });

    // Clique no backdrop: o alvo só é o próprio <dialog> fora do conteúdo.
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) dlg.close();
    });

    // O <dialog> nativo devolve o foco pro thumbnail que abriu o lightbox, mas
    // quem navegou com as setas saiu de outra foto — e voltar lá pro começo da
    // grade faz a pessoa perder o lugar. O rAF é o que importa aqui: a
    // restauração nativa é assíncrona e sobrescreve um focus() síncrono.
    dlg.addEventListener('close', function () {
      requestAnimationFrame(function () { botoes[atual].focus(); });
    });
  })();
</script>
</BaseLayout>
