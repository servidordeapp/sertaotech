# Espelha o CI: pint + phpstan + testes quando há PHP da api/; astro check quando há código do site/.
# Tudo roda dentro dos containers — o host só precisa do Docker.
staged_php=$(git diff --cached --name-only --diff-filter=ACMR -- 'api/*.php' | sed 's#^api/##')
staged_site=$(git diff --cached --name-only --diff-filter=ACMR -- 'site/src' 'site/astro.config.mjs' 'site/sentry.client.config.js' 'site/package.json')

# 1 se o serviço está de pé, 0 se não. `ps -q` só lista container rodando.
up() { [ -n "$(docker compose ps -q "$1" 2>/dev/null)" ]; }

if [ -n "$staged_php" ]; then
  if ! up api; then
    echo "husky: container 'api' não está rodando, suba com 'docker compose up -d'. Pulando checks da api." >&2
  else
    (
      echo "husky: pint (--test)"
      echo "$staged_php" | xargs docker compose exec -T api vendor/bin/pint --config=pint.json --test || exit 1
      echo "husky: phpstan"
      docker compose exec -T api composer stan || exit 1
      # MySQL do compose, banco `testing` — igual ao CI. Antes isto rodava em
      # SQLite em memória porque o MySQL só existia dentro do container.
      echo "husky: testes"
      docker compose exec -T api php artisan test --compact || exit 1
    ) || exit 1
  fi
fi

if [ -n "$staged_site" ]; then
  if ! up site; then
    echo "husky: container 'site' não está rodando, suba com 'docker compose up -d'. Pulando astro check." >&2
  else
    echo "husky: astro check"
    docker compose exec -T site npm run check --silent || exit 1
  fi
fi
