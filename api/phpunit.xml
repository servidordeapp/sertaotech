<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <!-- <server> com force: o docker-compose.yml define MAIL_* e
             CERTIFICADO_URL_* para a api usar o Mailpit e o site local, e o
             Laravel lê $_SERVER antes de $_ENV. Com <env>, mesmo forçado, os
             testes mandariam e-mail para o Mailpit e veriam as URLs de dev. -->
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="CERTIFICADO_URL_PAGINA" value="https://osertaotech.com.br/certificado" force="true"/>
        <server name="CERTIFICADO_URL_VALIDACAO" value="https://osertaotech.com.br/certificado/validar" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Origem do painel em dev. As rotas de /api/painel só ganham sessão
             quando a requisição vem de uma origem desta lista. -->
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
