APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Em produção: .osertaotech.com.br — é o que faz o cookie de sessão valer em
# painel.* e api.* ao mesmo tempo. Em dev fica null (localhost ignora porta).
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Administradores avisados a cada inscrição nova (separados por vírgula).
MAIL_ADMINS=
# Teto de e-mails por 24h do plano do provedor de SMTP. Subiu de plano? Só mudar aqui.
MAIL_LIMITE_DIARIO=100
# Produção (Resend): MAIL_MAILER=smtp, MAIL_HOST=smtp.resend.com, MAIL_PORT=465,
# MAIL_SCHEME=smtps, MAIL_USERNAME=resend, MAIL_PASSWORD=<API key re_...>,
# MAIL_FROM_ADDRESS num domínio verificado no Resend.

# Anexos do orçamento. Em produção é o Cloudflare R2: token em R2 > Manage API tokens,
# com o id da conta no endpoint. Em dev o docker-compose.yml aponta para o RustFS e
# ganha destes valores.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=osertaotech
AWS_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# Domínio público do bucket: é dele que sai o link "Abrir arquivo".
AWS_URL=https://arquivos.osertaotech.com.br
AWS_USE_PATH_STYLE_ENDPOINT=false

# Emissor dos certificados, impresso no rodapé de todas as edições.
CERTIFICADO_RESPONSAVEL="Maria Katriane de Sousa da Silva Oliveira"
CERTIFICADO_RAZAO_SOCIAL="BENTO LAB CONSULTORIA EM TI LTDA"
CERTIFICADO_CNPJ="69.141.827/0001-11"
# Em dev, aponte o QR Code e o botão do e-mail para o Astro local:
# CERTIFICADO_URL_VALIDACAO=http://localhost:4321/certificado/validar
# CERTIFICADO_URL_PAGINA=http://localhost:4321/certificado

VITE_APP_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=https://osertaotech.com.br,https://www.osertaotech.com.br,http://localhost:4321,http://localhost:5173

# Origens que recebem sessão por cookie em vez de token (o painel). Produção:
# painel.osertaotech.com.br. Sem a porta do Vite aqui, o login local devolve 401.
SANCTUM_STATEFUL_DOMAINS=localhost:5173

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true
