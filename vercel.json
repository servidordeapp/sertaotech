{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(ds|css)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/palestrantes", "destination": "/2026/palestrantes", "permanent": false },
    { "source": "/patrocinio", "destination": "/2026/patrocinio", "permanent": false },
    { "source": "/caravanas", "destination": "/2026/caravanas", "permanent": false }
  ]
}
