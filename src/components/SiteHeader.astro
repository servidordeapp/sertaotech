---
/**
 * Cabeçalho fixo. `active` marca aria-current no item da página atual.
 *
 * O botão de inscrição aponta pra /#inscricao por padrão. /caravanas manda
 * direto pro Sympla com UTM próprio (e a classe js-cta-inscricao, que o
 * modal de prazo daquela página intercepta), então aceita override.
 */
export interface Props {
  active?: string;
  ctaHref?: string;
  ctaClass?: string;
  ctaExternal?: boolean;
}
const {
  active,
  ctaHref = '/#inscricao',
  ctaClass = '',
  ctaExternal = false,
} = Astro.props;

const links = [
  { label: 'Sobre', href: '/#sobre', key: 'sobre' },
  { label: 'Cronograma', href: '/#agenda', key: 'agenda' },
  { label: 'Palestrantes', href: '/palestrantes', key: 'palestrantes' },
  { label: 'Caravanas', href: '/caravanas', key: 'caravanas' },
  { label: 'Patrocínio', href: '/patrocinio', key: 'patrocinio' },
  { label: 'Blog', href: '/blog', key: 'blog' },
];
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">
      <img src="/assets/logo-96.webp" alt="Sertão Tech" width="96" height="96" decoding="async" style="width: 40px; height: auto; max-width: 100%; object-fit: contain;">
      <span class="brand__word">Sertão Tech</span>
    </a>
    <button class="nav-toggle" type="button" id="navToggle" aria-controls="siteNav" aria-expanded="false" aria-label="Abrir menu"><svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg></button>
    <nav class="site-nav" id="siteNav" aria-label="Navegação principal">
      {links.map((link) => (
        <a class="site-nav__link" href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>
      ))}
      <span class="site-nav__sep" aria-hidden="true"></span>
      <a
        class:list={['btn', 'btn--primary', 'btn--sm', ctaClass]}
        href={ctaHref}
        {...(ctaExternal ? { target: '_blank', rel: 'noopener' } : {})}
      >Inscreva-se<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
    </nav>
  </div>
</header>
