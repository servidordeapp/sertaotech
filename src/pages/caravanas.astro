---
import BaseLayout from '../layouts/BaseLayout.astro';
import { graph, organization, website, webpage, breadcrumb } from '../lib/schema';
import caravanasSchema from '../data/caravanas-schema.json';

const title = 'Caravanas — Sertão Tech 2026 | como inscrever seu grupo';
const description =
  'Passo a passo para inscrever uma caravana no Sertão Tech 2026, na UFDPar, Parnaíba - PI. Mínimo de 20 e máximo de 50 pessoas por caravana.';

const jsonLd = graph(
  organization(),
  website(),
  webpage({ path: '/caravanas', name: title, description, image: '/assets/og-caravanas.jpg' }),
  breadcrumb([{ name: 'Caravanas', path: '/caravanas' }]),
  ...caravanasSchema,
);
---
<BaseLayout
  title={title}
  description={description}
  path="/caravanas"
  nav="caravanas"
  ctaHref="https://www.sympla.com.br/evento/sertao-tech/3549344?utm_source=site&utm_medium=cta_inscricao&utm_campaign=sertaotech-2026&utm_content=caravanas_nav"
  ctaClass="js-cta-inscricao"
  ctaExternal
  ogDescription="Como inscrever uma caravana no Sertão Tech 2026: o passo a passo completo, de 20 a 50 pessoas. 09 de outubro de 2026, na UFDPar — Parnaíba - PI."
  ogImage="/assets/og-caravanas.jpg"
  ogImageAlt="Caravanas do Sertão Tech 2026"
  jsonLd={jsonLd}
>

<main>

  <!-- CABEÇALHO DA PÁGINA -->
  <div class="band-ink">
    <section class="page-head">
      <div class="container">
        <nav class="breadcrumb" aria-label="Trilha de navegação">
          <a href="/">Sertão Tech 2026</a>
          <span aria-hidden="true">/</span>
          <span>Caravanas</span>
        </nav>
        <span class="eyebrow eyebrow--ink">// caravanas · 2ª edição</span>
        <h1 class="page-head__title">Traga sua caravana pro Sertão Tech.</h1>
        <p class="section-lead" style="color: var(--text-on-ink-muted); max-width: 640px;">Escola, instituto, universidade ou comunidade: quem leva um grupo de <strong style="color: var(--sand-100);">20 a 50 pessoas</strong> se inscreve de uma vez só, com desconto, em uma única compra. O passo a passo completo está logo abaixo.</p>
        <div class="hero__actions">
          <a class="btn btn--accent btn--lg js-cta-inscricao" href="https://www.sympla.com.br/evento/sertao-tech/3549344?utm_source=site&amp;utm_medium=cta_inscricao&amp;utm_campaign=sertaotech-2026&amp;utm_content=caravanas_topo" target="_blank" rel="noopener">Inscrever minha caravana<svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg></a>
          <a class="btn btn--outline-ink btn--lg" href="#passo-a-passo"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>Ver o passo a passo</a>
        </div>
      </div>
    </section>
  </div>

  <!-- O QUE É UMA CARAVANA -->
  <section class="section">
    <div class="container two-col">
      <div>
        <span class="eyebrow">// o que é</span>
        <h2 class="section-title">Uma inscrição só, o grupo inteiro dentro.</h2>
        <p class="prose">Caravana é a inscrição em grupo do Sertão Tech. Em vez de cada pessoa comprar o próprio ingresso, um responsável — coordenador de curso, professor, líder de comunidade ou representante de turma — faz uma única inscrição para todo mundo, com valor por pessoa menor que o do ingresso individual.</p>
        <p class="prose">Na 2ª edição, caravanas de instituições como <strong>IFPI</strong>, <strong>IFMA</strong>, <strong>UFDPar</strong> e comunidades em geral trazem estudantes de várias cidades do norte do Piauí e do entorno até o <a href="https://maps.app.goo.gl/yVJSv4X96VjH5xvC9" target="_blank" rel="noopener" style="text-decoration: underline;">UFDPar, em Parnaíba - PI</a>.</p>
        <div class="range-facts">
          <div class="range-fact">
            <span class="range-fact__k">mínimo</span>
            <div class="range-fact__v">20</div>
            <p class="range-fact__note">pessoas por caravana</p>
          </div>
          <div class="range-fact">
            <span class="range-fact__k">máximo</span>
            <div class="range-fact__v">50</div>
            <p class="range-fact__note">pessoas por caravana</p>
          </div>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <div class="feature-row" style="padding: 20px 22px;">
          <span class="chip-icon chip-icon--terra-sm"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
          <div>
            <h3>Desconto para grupos</h3>
            <p>O valor por pessoa na caravana é menor que o do ingresso individual.</p>
          </div>
        </div>
        <div class="feature-row" style="padding: 20px 22px;">
          <span class="chip-icon chip-icon--terra-sm"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg></span>
          <div>
            <h3>Uma compra, um pagamento</h3>
            <p>O responsável paga uma vez pelo grupo inteiro — sem correr atrás de 30 comprovantes.</p>
          </div>
        </div>
        <div class="feature-row" style="padding: 20px 22px;">
          <span class="chip-icon chip-icon--terra-sm"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg></span>
          <div>
            <h3>Instituição divulgada como apoiadora</h3>
            <p>A escola, instituto ou universidade que organiza a caravana é divulgada como apoiadora do evento.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PASSO A PASSO -->
  <div class="band-sunken">
    <section class="section" id="passo-a-passo">
      <div class="container">
        <span class="eyebrow">// passo a passo</span>
        <h2 class="section-title" style="margin-bottom: 8px;">Como inscrever a caravana</h2>
        <p class="section-lead" style="max-width: 640px; margin-bottom: 36px;">São cinco passos, do site até o comprovante no e-mail. Leva menos de cinco minutos.</p>

        <ol class="steps">
          <li class="step" id="passo-1">
            <span class="step__num" aria-hidden="true"></span>
            <div>
              <h3 class="step__title">Acesse o site do Sertão Tech <span class="chip">você está aqui</span></h3>
              <p class="step__text">Tudo começa em <a href="https://www.osertaotech.com.br/">osertaotech.com.br</a>. Se você está lendo esta página, esse passo já está concluído — pode ir direto para o próximo.</p>
            </div>
          </li>

          <li class="step" id="passo-2">
            <span class="step__num" aria-hidden="true"></span>
            <div>
              <h3 class="step__title">Clique no botão de inscrição</h3>
              <p class="step__text">No site, clique em <strong>Inscreva-se</strong> (no topo da página) ou em <strong>Fazer inscrição</strong> (no fim da página inicial). Você será redirecionado para o <strong>Sympla</strong>, a plataforma oficial de inscrições do evento.</p>
              <div class="step__hint">
                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                <span>A inscrição é feita só pelo Sympla. O site não cobra nada e não pede dados de pagamento em nenhuma tela.</span>
              </div>
            </div>
          </li>

          <li class="step" id="passo-3">
            <span class="step__num" aria-hidden="true"></span>
            <div>
              <h3 class="step__title">Selecione o ingresso “Caravana”</h3>
              <p class="step__text">Na página do evento no Sympla, aparece a lista de ingressos. Procure o item <strong>Caravana</strong> — é ele que dá o valor de grupo. O ingresso individual fica em outra linha da mesma lista.</p>
              <div class="step__hint">
                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                <span>Selecionou o ingresso errado? Volte à lista e zere a quantidade do outro ingresso antes de continuar.</span>
              </div>
            </div>
          </li>

          <li class="step" id="passo-4">
            <span class="step__num" aria-hidden="true"></span>
            <div>
              <h3 class="step__title">Escolha a quantidade de membros</h3>
              <p class="step__text">Ainda no ingresso Caravana, informe quantas pessoas vão no grupo. A quantidade precisa ficar entre <strong>20</strong> e <strong>50</strong>: menos de 20 pessoas não fecha caravana, e mais de 50 precisa ser combinado direto com a organização.</p>
              <div class="range-facts" style="margin-top: 16px;">
                <div class="range-fact" style="padding: 16px 18px;">
                  <span class="range-fact__k">mínimo</span>
                  <div class="range-fact__v" style="font-size: 32px;">20</div>
                  <p class="range-fact__note">pessoas</p>
                </div>
                <div class="range-fact" style="padding: 16px 18px;">
                  <span class="range-fact__k">máximo</span>
                  <div class="range-fact__v" style="font-size: 32px;">50</div>
                  <p class="range-fact__note">pessoas</p>
                </div>
              </div>
            </div>
          </li>

          <li class="step" id="passo-5">
            <span class="step__num" aria-hidden="true"></span>
            <div>
              <h3 class="step__title">Finalize a inscrição</h3>
              <p class="step__text">Preencha os dados do responsável pela caravana, conclua o pagamento e guarde o comprovante que o Sympla envia por e-mail. Depois disso, é só combinar a lista de participantes com a organização.</p>
              <div class="step__hint">
                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
                <span>Caravana confirmada? Chama a organização no WhatsApp <a href="https://wa.me/5586999202231" target="_blank" rel="noopener">+55 (86) 99920-2231</a> pra alinhar chegada, credenciamento e divulgação da instituição.</span>
              </div>
            </div>
          </li>
        </ol>

        <div class="hero__actions" style="margin-top: 32px;">
          <a class="btn btn--primary btn--lg js-cta-inscricao" href="https://www.sympla.com.br/evento/sertao-tech/3549344?utm_source=site&amp;utm_medium=cta_inscricao&amp;utm_campaign=sertaotech-2026&amp;utm_content=caravanas_passo_a_passo" target="_blank" rel="noopener">Ir para o Sympla e começar<svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
        </div>
      </div>
    </section>
  </div>

  <!-- DÚVIDAS -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">// dúvidas</span>
      <h2 class="section-title" style="margin-bottom: 28px;">Perguntas frequentes</h2>
      <div class="faq">
        <details>
          <summary>E se o grupo tiver menos de 20 pessoas?</summary>
          <p>Aí não fecha caravana. Cada pessoa faz a inscrição individual pelo Sympla, usando o mesmo botão de inscrição do site. Vocês continuam podendo viajar juntos — só a compra é que é separada.</p>
        </details>
        <details>
          <summary>E se o grupo passar de 50 pessoas?</summary>
          <p>Fale com a organização pelo WhatsApp <a href="https://wa.me/5586999202231" target="_blank" rel="noopener">+55 (86) 99920-2231</a>. Acima de 50 pessoas a gente combina o formato caso a caso, por causa da capacidade do espaço.</p>
        </details>
        <details>
          <summary>Preciso informar o nome de todos os participantes na hora da inscrição?</summary>
          <p>Não. Quem preenche os dados é o responsável pela caravana. A lista com o nome de cada participante pode ser enviada depois — a organização combina o prazo pelo WhatsApp.</p>
        </details>
        <details>
          <summary>Dá pra trocar alguém da caravana depois de inscrito?</summary>
          <p>Dá. Como a lista de participantes é enviada separadamente, trocar um nome antes do evento é só avisar a organização.</p>
        </details>
        <details>
          <summary>A organização ajuda com o transporte?</summary>
          <p>O transporte fica por conta de quem organiza a caravana. O que a organização faz é ajudar com material de divulgação e com a articulação junto à instituição de ensino — inclusive na conversa com coordenação e direção.</p>
        </details>
        <details>
          <summary>Todo mundo da caravana recebe certificado?</summary>
          <p>Sim. Cada participante da caravana tem os mesmos direitos de quem se inscreve individualmente: acesso a todas as palestras e à roda de conversa, certificado de participação, coffee break e sorteios.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta">
    <div class="cta__glow" aria-hidden="true"></div>
    <section class="section cta__inner">
      <div class="container">
        <span class="eyebrow eyebrow--ink">// bora encher o ônibus?</span>
        <h2 class="cta__title">Inscreva sua caravana.</h2>
        <p class="cta__lead">09 de outubro de 2026, das 14h às 21h30, na UFDPar — Parnaíba - PI. As vagas são limitadas e a caravana garante o grupo inteiro de uma vez.</p>
        <div class="hero__actions">
          <a class="btn btn--accent btn--lg js-cta-inscricao" href="https://www.sympla.com.br/evento/sertao-tech/3549344?utm_source=site&amp;utm_medium=cta_inscricao&amp;utm_campaign=sertaotech-2026&amp;utm_content=caravanas_rodape" target="_blank" rel="noopener">Inscrever minha caravana<svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg></a>
          <a class="btn btn--outline-ink btn--lg" href="https://wa.me/5586999202231" target="_blank" rel="noopener"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>Falar com a organização</a>
        </div>
      </div>
    </section>
  </div>

</main>

<Fragment slot="after-footer">
<!-- MODAL: inscrições encerradas / evento já aconteceu -->
<div class="modal-overlay" id="signupModal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="signupModalTitle" aria-describedby="signupModalDesc">
    <button class="modal__close" type="button" id="signupModalClose" aria-label="Fechar">
      <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
    <span class="chip-icon chip-icon--terra-sm"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg></span>
    <h2 class="modal__title" id="signupModalTitle">Inscrições encerradas</h2>
    <p class="modal__text" id="signupModalDesc">A 2ª edição do Sertão Tech aconteceu no dia 09 de outubro de 2026 e as inscrições já foram encerradas.</p>
    <p class="modal__text">Pra ficar sabendo da próxima edição em primeira mão, acompanha o <a href="https://instagram.com/osertaotech" target="_blank" rel="noopener">@osertaotech</a>.</p>
    <div class="modal__actions">
      <a class="btn btn--outline btn--md" href="https://instagram.com/osertaotech" target="_blank" rel="noopener">Seguir no Instagram</a>
      <button class="btn btn--primary btn--md" type="button" id="signupModalOk">Entendi</button>
    </div>
  </div>
</div>
</Fragment>

<script is:inline slot="scripts">
  // Inscrições: depois do evento, bloqueia o CTA e mostra o aviso de encerramento.
  // Mesma regra da home — a caravana também deixa de ser vendável quando o evento passa.
  (function () {
    var CLOSES_AT = new Date('2026-10-09T22:00:00-03:00'); // fim do evento (horário de Brasília)
    var ctaLinks = document.querySelectorAll('.js-cta-inscricao');
    var modal = document.getElementById('signupModal');
    if (!ctaLinks.length || !modal) return;

    var closeBtn = document.getElementById('signupModalClose');
    var okBtn = document.getElementById('signupModalOk');
    var lastFocused = null;

    function openModal(trigger) {
      lastFocused = trigger || document.activeElement;
      modal.hidden = false;
      document.body.classList.add('modal-open');
      if (closeBtn) closeBtn.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function closeModal() {
      modal.hidden = true;
      document.body.classList.remove('modal-open');
      document.removeEventListener('keydown', onKeydown);
      if (lastFocused) lastFocused.focus();
    }

    function onKeydown(e) {
      if (e.key === 'Escape') { closeModal(); return; }
      if (e.key !== 'Tab') return;
      var focusable = modal.querySelectorAll('button, a[href]');
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }

    ctaLinks.forEach(function (link) {
      link.addEventListener('click', function (e) {
        if (Date.now() > CLOSES_AT.getTime()) {
          e.preventDefault();
          openModal(link);
        }
      });
    });

    closeBtn.addEventListener('click', closeModal);
    okBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });
  })();
</script>

</BaseLayout>