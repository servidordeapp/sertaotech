# Fotos e artes originais (alta resolução) usadas só para gerar os assets
# otimizados em assets/. Ficam locais, fora do versionamento.
/originais/

# Dependências de qualquer aplicação do monorepo (raiz, site/, api/…)
node_modules/

# Saída e cache do Astro (site/dist, site/.astro)
dist/
.astro/

# Cache da CLI da Vercel
.vercel/

# Planilhas de participantes têm dado pessoal: nunca entram no repositório.
*.xlsx
